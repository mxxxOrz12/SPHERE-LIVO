<launch>
  <arg name="seq_name" default="sphere_oxford" />
  <arg name="ablation" default="none" />
  <include file="$(find fast_livo)/launch/mapping_sphere.launch">
    <arg name="sensor_config" value="$(find fast_livo)/config/sphere_oxford.yaml" />
    <arg name="seq_name" value="$(arg seq_name)" />
    <arg name="ablation" value="$(arg ablation)" />
  </include>
</launch>
